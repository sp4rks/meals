{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meals",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./design",
    "run_worker_first": ["/"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meals",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "meals"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
